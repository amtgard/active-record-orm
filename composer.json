{
    "name"  : "amtgard/active-record-orm",
    "type"  : "library",
    "homepage": "https://github.com/amtgard/active-record-orm",
    "license" : "MIT",
    "description": "Active Record ORM for the ORK4",
    "require-dev": {
        "phake/phake": "^4.5",
        "phpunit/phpunit": "^11.3",
        "robmorgan/phinx": "^0.16.8",
        "ext-openssl": "*",
        "phpstan/phpstan": "^2.1"
    },
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "monolog/monolog": "^3.7",
        "ext-pdo": "*",
        "vlucas/phpdotenv": "^5.6",
        "amtgard/builder-traits": "^2.1",
        "jedibc/optional": "^1.0",
        "amtgard/phpunit-extensions": "^1.0",
        "wyndow/fuzzywuzzy": "^0.6.0"
    },
    "autoload": {
        "psr-4": {
            "Amtgard\\ActiveRecordOrm\\": "./src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Tests\\Integration\\": "tests/integ",
            "Tests\\Unit\\": "tests/unit"
        }
    },
    "bin": [
        "./bin/"
    ]
}
