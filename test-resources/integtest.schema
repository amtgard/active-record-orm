create table integ
(
    id             int(11) unsigned auto_increment
        primary key,
    int_value      int                          null,
    string_value   varchar(255)                 null,
    datetime_value datetime                     null,
    blob_value     blob                         null,
    text_value     text                         null,
    json_value     longtext collate utf8mb4_bin null
        check (json_valid(`json_value`)),
    binary_value   binary(1)                    null,
    boolean_value  tinyint(1)                   null,
    enum_value     enum ('alpha', 'beta')       null,
    double_value   double                       null,
    uuid_value     uuid                         null,
    decimal_value  decimal                      null
);
